<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">

  <!-- ===== Параметризация ===== -->
  <xacro:property name="base_length" value="0.50"/>
  <xacro:property name="base_width"  value="0.30"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass"   value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.3"/>
  <xacro:property name="track"        value="0.30"/>
  <xacro:property name="wheelbase"    value="0.35"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_mass"   value="0.2"/>

  <xacro:property name="camera_size" value="0.04"/>
  <xacro:property name="camera_mass" value="0.1"/>

  <xacro:property name="imu_size" value="0.02"/>
  <xacro:property name="imu_mass" value="0.05"/>

  <!-- ===== base_link ===== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="${(1.0/12.0)*base_mass*(base_width*base_width+base_height*base_height)}"
               iyy="${(1.0/12.0)*base_mass*(base_length*base_length+base_height*base_height)}"
               izz="${(1.0/12.0)*base_mass*(base_length*base_length+base_width*base_width)}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== lidar_link (parent: base_link) ===== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}"
               iyy="${(1.0/12.0)*lidar_mass*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}"
               izz="${(1.0/2.0)*lidar_mass*lidar_radius*lidar_radius}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="lidar_link"/>
    <origin xyz="${wheelbase/2 - 0.05} 0 ${base_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== camera_link (parent: base_link) ===== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <inertia ixx="${(1.0/6.0)*camera_mass*camera_size*camera_size}"
               iyy="${(1.0/6.0)*camera_mass*camera_size*camera_size}"
               izz="${(1.0/6.0)*camera_mass*camera_size*camera_size}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== imu_link (parent: base_link) ===== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="${imu_size} ${imu_size} ${imu_size}"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${imu_size} ${imu_size} ${imu_size}"/></geometry>
    </collision>
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia ixx="${(1.0/6.0)*imu_mass*imu_size*imu_size}"
               iyy="${(1.0/6.0)*imu_mass*imu_size*imu_size}"
               izz="${(1.0/6.0)*imu_mass*imu_size*imu_size}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height/2 + imu_size/2}" rpy="0 0 0"/>
  </joint>

</robot>